APP_NAME=Programma
APP_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_PATH=./data/programma.json
DEMO_MODE=false

# Optional AI reviewer. Proposal content and rubric context are sent without speaker PII.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Override only for an OpenAI-compatible development proxy.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional one-way Accelevents sync.
ACCELEVENTS_EVENT_URL=
ACCELEVENTS_API_KEY=
# Override only for an Accelevents-compatible test endpoint.
ACCELEVENTS_BASE_URL=https://api.accelevents.com

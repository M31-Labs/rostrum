APP_NAME=Rostrum
APP_ENV=development
# Deployment posture: live (default) or preview. APP_MODE=preview is a
# generic, fail-closed observer posture for an operator-supplied, checksummed
# workspace template. A normal organizer deployment always uses live.
APP_MODE=live
# Set this to the immutable release tag or commit SHA in a deployment. It is
# returned by GET /api/health so operators can prove which build is running.
ROSTRUM_VERSION=dev
PORT=8080
PUBLIC_URL=http://localhost:8080
# Deliberately too short: production refuses to start until this is replaced.
SESSION_SECRET=REPLACE_ME
DATA_PATH=./data/rostrum.json
# Canonical persistence backend: json (default), sqlite, postgres, or
# postgresql. SQLite uses WAL mode and creates its parent directory; Postgres
# reads DATABASE_URL and keeps credentials out of logs and workspace state.
STORE_DRIVER=json
DATABASE_URL=
# Independent, fsync-backed JSON Lines audit ledger. Keep it on durable
# operator-owned storage; it is intentionally separate from DATA_PATH.
AUDIT_LOG_PATH=./data/audit.log
# Validated workspace imports create an exact pre-import JSON backup here;
# Rostrum retains the newest ten backups.
BACKUP_DIR=./data/backups
UPLOAD_DIR=./data/uploads

# Reset guard. When RESET_SECRET is set, an authenticated organizer/chair must
# send the matching value as the POST form field named "secret". Never put it
# in a URL. Production disables reset entirely when this remains empty.
RESET_SECRET=

# Comma-separated CIDR networks for reverse proxies allowed to append
# X-Forwarded-For. Keep empty without a proxy. Never use 0.0.0.0/0 or ::/0;
# use the exact loopback, container, or cluster network your proxy connects
# from. Invalid values stop startup before the server listens.
TRUSTED_PROXY_CIDRS=

# Optional outbound email. MAIL_DRIVER may be outbox, resend, or smtp. When it
# is unset, a configured RESEND_API_KEY wins, then SMTP_HOST, otherwise mail
# records to the local outbox. SMTP remains a standards-based self-host option.
MAIL_DRIVER=
RESEND_API_KEY=
# Override only for a Resend-compatible test endpoint.
RESEND_API_BASE_URL=https://api.resend.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Rostrum <noreply@example.com>

# Optional one-way Accelevents sync.
ACCELEVENTS_EVENT_URL=
ACCELEVENTS_API_KEY=
# Override only for an Accelevents-compatible test endpoint.
ACCELEVENTS_BASE_URL=https://api.accelevents.com

# Optional one-way Airtable projection. Use a Personal Access Token scoped to
# this base with record-write access; Rostrum never stores the token in state.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_SPEAKERS_TABLE=Speakers
AIRTABLE_SESSIONS_TABLE=Sessions
# Override only for a loopback or Airtable-compatible test endpoint.
AIRTABLE_API_BASE_URL=https://api.airtable.com/v0

# Organizer identity plane (see docs/deployment.md "Identity and access").
# ORGANIZER_EMAILS is a comma-separated allowlist: a magic-link or OAuth
# sign-in from one of these addresses is granted the organizer role. Leave
# it empty on a fresh self-host with no stored organizer yet — the process
# logs a one-time break-glass /setup link at startup instead.
ORGANIZER_EMAILS=
# Optional durable role provisioning. Use email=none for an explicit
# revocation that cannot be re-elevated by ORGANIZER_EMAILS, for example:
# owner@example.com=organizer,chair@example.com=chair,old@example.com=none
PRINCIPAL_ROLES=

# Optional GitHub OAuth sign-in. Set both to show the "Continue with GitHub"
# button on /login. Redirect URL: {PUBLIC_URL}/auth/oauth/github/callback.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Optional GitHub login-handle allowlist for organizer bootstrap. Handles are
# matched case-insensitively and only apply to verified GitHub OAuth callbacks;
# after first sign-in, the durable email principal and PRINCIPAL_ROLES govern
# access and revocation. Keep this empty unless GitHub is configured.
AUTH_GITHUB_HANDLES=

# Optional Google OAuth sign-in. Set both to show the "Continue with
# Google" button on /login. Redirect URL: {PUBLIC_URL}/auth/oauth/google/callback.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Initial workspace. "fresh" (the production default) creates one placeholder
# event and an editable CFP; "empty" creates only the event skeleton. To start
# from a validated raw State document, set INITIAL_WORKSPACE_PATH instead and
# pin its exact bytes with INITIAL_WORKSPACE_SHA256 (or the file variant used
# by an init container). Initialization only runs when the configured store is
# empty; it never overwrites an existing workspace.
INITIAL_WORKSPACE=fresh
INITIAL_WORKSPACE_PATH=
INITIAL_WORKSPACE_SHA256=
INITIAL_WORKSPACE_SHA256_FILE=

# Optional operator-owned Arbiter policy for category routing. The built-in
# policy safely routes everything to unassigned program triage. Pin an exact
# external policy for repeatable deployments; preview mode requires the pin.
CFP_ROUTING_POLICY_PATH=
CFP_ROUTING_POLICY_SHA256=
CFP_ROUTING_POLICY_SHA256_FILE=

# Optional presentation text for APP_MODE=preview. These values do not enable
# preview mode and have no effect in a live organizer deployment.
PREVIEW_LABEL=Observer workspace
PREVIEW_MESSAGE=Explore this read-only workspace. Controls that create, move, publish, upload, or save are not shown.

APP_NAME=Rostrum
APP_ENV=development
# Deployment posture: live (default) or demo. APP_MODE=demo is for a
# separate, fictional, durable, anonymous read-only hosted preview; it fails
# closed if pointed at credentials, a real workspace, or in-memory storage.
APP_MODE=live
# Set this to the immutable release tag or commit SHA in a deployment. It is
# returned by GET /api/health so operators can prove which build is running.
ROSTRUM_VERSION=dev
PORT=8080
PUBLIC_URL=http://localhost:8080
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_PATH=./data/rostrum.json
# Canonical persistence backend: json (default), sqlite, postgres, or
# postgresql. SQLite uses WAL mode and creates its parent directory; Postgres
# reads DATABASE_URL and keeps credentials out of logs and workspace state.
STORE_DRIVER=json
DATABASE_URL=
# Independent, fsync-backed JSON Lines audit ledger. Keep it on durable
# operator-owned storage; it is intentionally separate from DATA_PATH.
AUDIT_LOG_PATH=./data/audit.log
# Validated workspace imports create an exact pre-import JSON backup here;
# Rostrum retains the newest ten backups.
BACKUP_DIR=./data/backups
DEMO_MODE=false

# Reset guard. When RESET_SECRET is set, POST /demo/reset requires a matching
# ?secret=<value>. In production with no secret set, reset is disabled entirely
# so a deployed demo cannot be wiped by a visitor.
RESET_SECRET=

# Optional outbound email. MAIL_DRIVER may be outbox, resend, or smtp. When it
# is unset, a configured RESEND_API_KEY wins, then SMTP_HOST, otherwise mail
# records to the demo outbox. SMTP remains a standards-based self-host option.
MAIL_DRIVER=
RESEND_API_KEY=
# Override only for a Resend-compatible test endpoint.
RESEND_API_BASE_URL=https://api.resend.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Rostrum <noreply@example.com>

# Optional one-way Accelevents sync.
ACCELEVENTS_EVENT_URL=
ACCELEVENTS_API_KEY=
# Override only for an Accelevents-compatible test endpoint.
ACCELEVENTS_BASE_URL=https://api.accelevents.com

# Optional one-way Airtable projection. Use a Personal Access Token scoped to
# this base with record-write access; Rostrum never stores the token in state.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_SPEAKERS_TABLE=Speakers
AIRTABLE_SESSIONS_TABLE=Sessions
# Override only for a loopback or Airtable-compatible test endpoint.
AIRTABLE_API_BASE_URL=https://api.airtable.com/v0

# Organizer identity plane (see docs/deployment.md "Identity and access").
# ORGANIZER_EMAILS is a comma-separated allowlist: a magic-link or OAuth
# sign-in from one of these addresses is granted the organizer role. Leave
# it empty on a fresh self-host with no stored organizer yet — the process
# logs a one-time break-glass /setup link at startup instead.
ORGANIZER_EMAILS=

# Optional GitHub OAuth sign-in. Set both to show the "Continue with GitHub"
# button on /login. Redirect URL: {PUBLIC_URL}/auth/oauth/github/callback.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Optional Google OAuth sign-in. Set both to show the "Continue with
# Google" button on /login. Redirect URL: {PUBLIC_URL}/auth/oauth/google/callback.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Initial workspace dataset. "demo" (default) seeds the full polished demo
# dataset. "fresh" seeds one placeholder event and one open call for
# proposals with nothing else. "empty" seeds only the event skeleton with
# no call for proposals. SEED only takes effect the first time the data
# file is created; it has no effect against an existing DATA_PATH.
SEED=demo

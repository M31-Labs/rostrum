# Rostrum's built-in routing policy is deliberately generic. It keeps a fresh
# organizer workspace useful without inventing category owners, queues, or
# tracks that do not exist in that workspace. Operators can supply a pinned
# policy through CFP_ROUTING_POLICY_PATH; the fictional evaluation policy
# lives only under examples/demo/rules/.

feature submission from "rostrum" {
    category: string
    format: string
    level: string
}

rule RouteProgramTriage priority 99 {
    when {
        true
    }
    then RouteSubmission {
        queue: "program-triage",
        owner: "Program team",
        track: "",
        reason: "default intake route until the program team installs a category policy",
    }
}

# Dynamic CFP fields use an intentionally constrained question rule. The
# builder may select a source question, an exact answer, and a target question;
# it cannot inject arbitrary source or decision code. The host records the
# target field alongside this policy result in the audit trail.

feature answer from "rostrum" {
    value: string
    expected: string
    effect: string
}

rule ShowMatchingAnswer priority 1 {
    when {
        answer.effect == "show" and answer.value == answer.expected
    }
    then FieldVisibility {
        visible: true,
        reason: "the selected answer makes this question relevant",
    }
}

rule HideNonMatchingAnswer priority 99 {
    when {
        answer.effect == "show" and answer.value != answer.expected
    }
    then FieldVisibility {
        visible: false,
        reason: "the selected answer does not make this question relevant",
    }
}
